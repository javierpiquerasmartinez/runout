{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "runout",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "runout-imports",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@runout/server",
        "dev:imports"
      ],
      "port": 3001
    },
    {
      "name": "runout-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@runout/server",
        "dev"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "runout-web-ipv4",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@runout/web",
        "exec",
        "vite",
        "--host",
        "127.0.0.1",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173,
      "autoPort": false,
      "url": "http://127.0.0.1:5173"
    }
  ]
}
