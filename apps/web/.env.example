# Copy to .env.local. Only needed in production, where the backend is a different origin
# (Render) from the frontend (Vercel). Unset locally: Vite's dev-server proxy (vite.config.ts)
# already makes /api and /ws same-origin.
# VITE_BACKEND_URL=https://runout-4oc4.onrender.com

# The OAuth client ID for "Sign in with Google", the same as the server's GOOGLE_CLIENT_ID.
# Needed locally too. See the README.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
