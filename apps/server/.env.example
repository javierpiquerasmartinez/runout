# Copy to .env. Any Postgres works; `pnpm db:local` starts one matching this URL.
DATABASE_URL=postgres://runout:runout@localhost:5432/runout

# Only needed in production, where the frontend is a different origin (e.g. Vercel).
# Comma-separated if you need to allow more than one. Unset locally: with no value the
# server allows any origin, which is fine since local dev never sees a real cross-origin request.
# FRONTEND_URL=https://runout.vercel.app

# The OAuth client ID that Google ID tokens must be issued for. Required: the server refuses to
# start without it. The web uses the same one as VITE_GOOGLE_CLIENT_ID. See the README.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Local development only: lets the web's "Test mode" sign in as fixed test Accounts without
# Google. Off unless "true". The server refuses to start with it set alongside FRONTEND_URL.
# DEV_SIGN_IN=true

# The Administrators: emails of Accounts, comma-separated, matched ignoring case. Set only here,
# never from Runout itself. Unset, nobody is one. See the README.
# ADMINISTRATOR_EMAILS=tester-a@dev.runout.test

# Production only: Invitations and password resets go out through Resend, from a sender on a
# domain verified there. With FRONTEND_URL set the server refuses to start without both. Locally,
# emails are printed to the server's console instead.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Runout <hola@runout.app>
