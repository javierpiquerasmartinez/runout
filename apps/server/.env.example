# Copy to .env. Any Postgres works; `pnpm db:local` starts one matching this URL.
DATABASE_URL=postgres://runout:runout@localhost:5432/runout

# Only needed in production, where the frontend is a different origin (e.g. Vercel).
# Comma-separated if you need to allow more than one. Unset locally: with no value the
# server allows any origin, which is fine since local dev never sees a real cross-origin request.
# FRONTEND_URL=https://runout.vercel.app
